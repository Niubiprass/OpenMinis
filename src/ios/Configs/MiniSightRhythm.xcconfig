// Default development/source builds MUST NOT acquire the live transport.
// Only the existing CI xcodebuild command sets MINISIGHT_RHYTHM_PAIR=1.
MINISIGHT_RHYTHM_PAIR = 0
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) MINISIGHT_ENABLE_RHYTHM_CAPTURE=$(MINISIGHT_RHYTHM_PAIR) MINISIGHT_ENABLE_RHYTHM_TRANSPORT=$(MINISIGHT_RHYTHM_PAIR) MINISIGHT_RHYTHM_LIVE_BUILD=$(MINISIGHT_RHYTHM_PAIR)
